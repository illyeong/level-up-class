{
  "name": "levelup-class-teacher-widget",
  "version": "1.0.0",
  "private": true,
  "description": "LevelUp Class teacher desktop mini widget",
  "main": "main.cjs",
  "author": "LevelUp Class",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 && node generate-latest-yml.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.levelupclass.teacherwidget",
    "productName": "LevelUp Class 위젯",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "styles.css"
    ],
    "artifactName": "LevelUpTeacherWidgetSetup.exe",
    "publish": {
      "provider": "github",
      "owner": "illyeong",
      "repo": "level-up-class",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
